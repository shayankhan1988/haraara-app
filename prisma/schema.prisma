generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CURATOR
  MODERATOR
  ADMIN
}

enum DealStatus {
  PENDING
  PUBLISHED
  REJECTED
  EXPIRED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  role         Role      @default(USER)
  locale       String    @default("en")
  banned       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  deals        Deal[]
  votes        Vote[]
  comments     Comment[]
  alerts       Alert[]
  notifications Notification[]
  reports      Report[]
  clicks       Click[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id     String  @id @default(cuid())
  slug   String  @unique
  nameEn String
  nameAr String
  sort   Int     @default(0)
  deals  Deal[]
  alerts Alert[]
}

model Merchant {
  id                String  @id @default(cuid())
  name              String
  domain            String  @unique
  // Deeplink-sjabloon van een netwerk (bv. Optimise), {url} = ge-encodeerde doel-URL.
  // Voorbeeld: "https://track.example.net/click?aid=123&r={url}"
  affiliateTemplate String?
  // Of: queryparameters die aan de doel-URL worden toegevoegd, bv. Amazon "tag=jouwtag-21"
  affiliateParams   String?
  country           String  @default("AE")
  deals             Deal[]
}

model Deal {
  id            String     @id @default(cuid())
  title         String
  description   String
  url           String
  price         Decimal?   @db.Decimal(12, 2)
  originalPrice Decimal?   @db.Decimal(12, 2)
  currency      String     @default("AED")
  couponCode    String?
  imageUrl      String?
  country       String     @default("AE")
  locale        String     @default("en")
  status        DealStatus @default(PENDING)
  temperature   Int        @default(0)
  hotCount      Int        @default(0)
  coldCount     Int        @default(0)
  commentCount  Int        @default(0)
  clickCount    Int        @default(0)
  expiresAt     DateTime?
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  categoryId    String
  category      Category   @relation(fields: [categoryId], references: [id])
  merchantId    String?
  merchant      Merchant?  @relation(fields: [merchantId], references: [id])
  votes         Vote[]
  comments      Comment[]
  clicks        Click[]
  reports       Report[]
  notifications Notification[]

  @@index([status, country, publishedAt])
  @@index([status, country, temperature])
  @@index([categoryId])
}

model Vote {
  userId    String
  dealId    String
  value     Int // +1 = hot, -1 = cold
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@id([userId, dealId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  reports   Report[]

  @@index([dealId, createdAt])
}

model Alert {
  id            String         @id @default(cuid())
  keyword       String?
  maxPrice      Decimal?       @db.Decimal(12, 2)
  minTemperature Int?
  createdAt     DateTime       @default(now())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id])
  notifications Notification[]

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  alertId   String?
  alert     Alert?   @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@unique([userId, dealId])
  @@index([userId, read])
}

model Report {
  id        String       @id @default(cuid())
  reason    String
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  dealId    String?
  deal      Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Click {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipHash    String?
  userAgent String?
  referrer  String?
  country   String?

  @@index([dealId, createdAt])
  @@index([createdAt])
}
